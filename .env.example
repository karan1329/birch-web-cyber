# ─────────────────────────────────────────────────────────────────────────
# Birchlogic — environment variables
# Copy this file to `.env.local` and fill the values in for local dev,
# then mirror them in Vercel (or your host's env settings) for production.
# ─────────────────────────────────────────────────────────────────────────

# Cloudflare Turnstile — CAPTCHA on /contact and /careers/apply.
# Get a site key + secret at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both unset in local dev to use the public Cloudflare test keys
# (always pass, visible to you as the "For testing only" badge).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — email delivery for form submissions.
# Get an API key at https://resend.com/api-keys.
# `MAIL_FROM` must be a verified sender on a verified domain. Until
# birchlogic.com is verified, fall back to `onboarding@resend.dev`.
# `MAIL_TO` is where every form submission lands; defaults to hi@birchlogic.com.
RESEND_API_KEY=
MAIL_FROM="Birchlogic <noreply@birchlogic.com>"
MAIL_TO=hi@birchlogic.com
